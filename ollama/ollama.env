# Settings for the shared Ollama server (read by ollama/serve.sh at each start).
# Change a value, then use "Restart Ollama" in the menu bar icon (or: scripts/service.sh restart).
# All Ollama variables: `ollama serve --help`.

# Where it listens. Every app (LeadScout, TradeFlow's Sentinel, Docker via host.docker.internal) uses this.
# Localhost only: never expose it on the network (SPEC.md §7).
OLLAMA_HOST=127.0.0.1:11434

# How long a model stays in memory after its last request (Ollama default 5m; -1 = forever, SPEC.md §6).
# OLLAMA_KEEP_ALIVE=5m

# Requests one model serves at once (SPEC.md §4 suggests 2; each slot costs memory).
# OLLAMA_NUM_PARALLEL=1
